# Copy this file to .env and change the values.
# .env is in .gitignore, so your real passwords never reach GitHub.
POSTGRES_USER=tasktrack
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=tasktrack

# How the backend finds the database. "db" is the service name in docker-compose.yml;
# Docker's internal DNS resolves it to the database container.
DATABASE_URL=postgresql+psycopg://tasktrack:change-me-locally@db:5432/tasktrack
